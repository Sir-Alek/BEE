# GBNF Grammar for Gherkin BDD output (LEGACY — superseded by bdd_response.gbnf in 0.9.65)
# Restricts llama.cpp inference to valid Gherkin syntax only.
# Used by BDDDocConverter to guarantee syntactically valid .feature output.

root ::= feature-block

feature-block ::= "Feature: " text newline scenario+

scenario ::= newline "  Scenario: " text newline step+

step ::= "    " keyword " " text newline

keyword ::= "Given" | "When" | "Then" | "And" | "But"

text ::= [^\n\r]+

newline ::= "\n"
