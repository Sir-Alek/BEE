# JSON BDD response with Chain-of-Thought analysis + structured steps.
# Used by bdd_doc_converter (Doc-to-BDD) via llama.cpp LlamaGrammar.

root ::= "{" ws "\"analisis_previo\"" ":" ws string "," ws "\"scenario_title\"" ":" ws string "," ws "\"steps\"" ":" ws steps-array ws "}" ws

steps-array ::= "[" ws step-object ("," ws step-object)* "]"

step-object ::= "{" ws "\"keyword\"" ":" ws keyword "," ws "\"text\"" ":" ws string "}"

keyword ::= "\"Given\"" | "\"When\"" | "\"Then\"" | "\"And\"" | "\"But\""

string ::= "\"" char* "\""

char ::= [^"\\] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F])

ws ::= [ \t\n\r]*
